<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>MJC</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('navbar') %>
  <div class="container">
    <h1>🏢 MJC</h1>

    <form id="formMjc">
      <input type="text" id="nom"       placeholder="Nom de la MJC" required>
      <input type="text" id="adresse"   placeholder="Adresse">
      <input type="text" id="telephone" placeholder="Téléphone">
      <button type="submit">➕ Ajouter</button>
    </form>

    <table>
      <thead>
        <tr>
          <th>ID</th><th>Nom</th><th>Adresse</th><th>Téléphone</th><th>Action</th>
        </tr>
      </thead>
      <tbody id="tableMjc"></tbody>
    </table>
  </div>

  <script>
    async function chargerMjc() {
      const response = await fetch('/api/mjc');
      const data     = await response.json();
      const tbody    = document.getElementById('tableMjc');
      tbody.innerHTML = '';

      data.forEach(m => {
        tbody.innerHTML += `
          <tr>
            <td>${m.id_mjc}</td>
            <td>${m.nom}</td>
            <td>${m.adresse   || '-'}</td>
            <td>${m.telephone || '-'}</td>
            <td><button onclick="supprimer(${m.id_mjc})">🗑️</button></td>
          </tr>`;
      });
    }

    document.getElementById('formMjc').addEventListener('submit', async (e) => {
      e.preventDefault();
      await fetch('/api/mjc', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nom:       document.getElementById('nom').value,
          adresse:   document.getElementById('adresse').value,
          telephone: document.getElementById('telephone').value
        })
      });
      e.target.reset();
      chargerMjc();
    });

    async function supprimer(id) {
      if (!confirm('Supprimer ?')) return;
      await fetch(`/api/mjc/${id}`, { method: 'DELETE' });
      chargerMjc();
    }

    chargerMjc();
  </script>
</body>
</html>