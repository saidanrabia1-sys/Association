<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Associations</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('navbar') %>
  <div class="container">
    <h1>🤝 Associations</h1>

    <form id="formAssociation">
      <input type="text"  id="nom"           placeholder="Nom de l'association" required>
      <input type="text"  id="numero"        placeholder="Numéro (ex: M001)">
      <input type="text"  id="siret"         placeholder="SIRET">
      <input type="text"  id="adresse"       placeholder="Adresse">
      <input type="date"  id="date_creation">
      <input type="text"  id="telephone"     placeholder="Téléphone">
      <input type="text"  id="president"     placeholder="Président">
      <button type="submit">➕ Ajouter</button>
    </form>

    <table>
      <thead>
        <tr>
          <th>ID</th><th>Nom</th><th>Numéro</th><th>SIRET</th>
          <th>Adresse</th><th>Date création</th><th>Téléphone</th>
          <th>Président</th><th>Action</th>
        </tr>
      </thead>
      <tbody id="tableAssociations"></tbody>
    </table>
  </div>

  <script>
    async function chargerAssociations() {
    const response = await fetch('/api/associations');
    const data     = await response.json();

    // Debug : voir ce que retourne l'API
    console.log("Données reçues :", data[0]);

    const tbody = document.getElementById('tableAssociations');
    tbody.innerHTML = '';

    data.forEach(a => {
        const date = a.date_creation
            ? new Date(a.date_creation).toLocaleDateString('fr-FR') : '-';

        tbody.innerHTML += `
            <tr>
                <td>${a.id_association ?? a.id ?? '-'}</td>
                <td>${a.nom          ?? '-'}</td>
                <td>${a.numero       ?? '-'}</td>
                <td>${a.siret        ?? '-'}</td>
                <td>${a.adresse      ?? '-'}</td>
                <td>${date}</td>
                <td>${a.telephone    ?? '-'}</td>
                <td>${a.president    ?? '-'}</td>
                <td><button onclick="supprimer(${a.id_association ?? a.id})">🗑️</button></td>
            </tr>`;
    });
}
  </script>
</body>
</html>