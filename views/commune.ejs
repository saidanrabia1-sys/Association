<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Communes</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('navbar') %>
  <div class="container">
    <h1>🏛️ Communes de Mayotte</h1>

    <form id="formCommune">
      <input type="text" id="nom"       placeholder="Nom de la commune" required>
      <input type="text" id="adresse"   placeholder="Adresse">
      <input type="text" id="telephone" placeholder="Téléphone">
      <input type="text" id="president" placeholder="Maire / Président">
      <button type="submit">➕ Ajouter</button>
    </form>

    <table>
      <thead>
        <tr>
          <th>ID</th><th>Nom</th><th>Adresse</th>
          <th>Téléphone</th><th>Président</th><th>Action</th>
        </tr>
      </thead>
      <tbody id="tableCommunes"></tbody>
    </table>
  </div>

  <script>
    async function chargerCommunes() {
      const response = await fetch('/api/communes');
      const data     = await response.json();
      const tbody    = document.getElementById('tableCommunes');
      tbody.innerHTML = '';

      data.forEach(c => {
        tbody.innerHTML += `
          <tr>
            <td>${c.id}</td>
            <td>${c.nom}</td>
            <td>${c.adresse   || '-'}</td>
            <td>${c.telephone || '-'}</td>
            <td>${c.president || '-'}</td>
            <td><button onclick="supprimer(${c.id})">🗑️</button></td>
          </tr>`;
      });
    }

    document.getElementById('formCommune').addEventListener('submit', async (e) => {
      e.preventDefault();
      await fetch('/api/communes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nom:       document.getElementById('nom').value,
          adresse:   document.getElementById('adresse').value,
          telephone: document.getElementById('telephone').value,
          president: document.getElementById('president').value
        })
      });
      e.target.reset();
      chargerCommunes();
    });

    async function supprimer(id) {
      if (!confirm('Supprimer ?')) return;
      await fetch(`/api/communes/${id}`, { method: 'DELETE' });
      chargerCommunes();
    }

    chargerCommunes();
  </script>
</body>
</html>