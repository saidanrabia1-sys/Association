<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Réservations</title>
  <link rel="stylesheet" href="/css/style.css"> <!-- ✅ ajout du / -->
</head>
<body>

  <%- include('navbar') %>

  <div class="container">
    <h1>📅 Réservations</h1>

    <form id="formReservation">
      <select id="id_association" required>
        <option value="">-- Choisir une association --</option>
      </select>
      <select id="id_mjc" required>
        <option value="">-- Choisir une MJC --</option>
      </select>
      <input type="date" id="date_reservation" required>
      <button type="submit">➕ Ajouter une réservation</button>
    </form>

    <table>
      <thead>
        <tr>
          <th>Association</th>
          <th>MJC</th>
          <th>Date</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="tableReservations"></tbody>
    </table>
  </div>

  <script>
    // ===================================================
    // CHARGER LES SELECTS (associations + mjc)
    // ===================================================
    async function chargerSelects() {
      const associations = await fetch('/api/associations').then(r => r.json()); // ✅ /api/
      const mjcs         = await fetch('/api/mjc').then(r => r.json());          // ✅ /api/

      const selA = document.getElementById('id_association');
      associations.forEach(a => {
        selA.innerHTML += `<option value="${a.id_association}">${a.nom}</option>`; // ✅ id_association
      });

      const selM = document.getElementById('id_mjc');
      mjcs.forEach(m => {
        selM.innerHTML += `<option value="${m.id}">${m.nom}</option>`;
      });
    }

    // ===================================================
    // CHARGER LES RÉSERVATIONS
    // ===================================================
    async function charger() {
      const res  = await fetch('/api/reservations'); // ✅ /api/
      const data = await res.json();
      const tbody = document.getElementById('tableReservations');
      tbody.innerHTML = '';

      data.forEach(r => {
        const date = r.date_reservation
          ? new Date(r.date_reservation).toLocaleDateString('fr-FR')
          : '-';

        tbody.innerHTML += `
          <tr>
            <td>${r.association || r.id_association}</td>
            <td>${r.mjc || r.id_mjc}</td>
            <td>${date}</td>
            <td>
              <button onclick="supprimer(${r.id})">🗑️ Supprimer</button>
            </td>
          </tr>`;
      });
    }

    // ===================================================
    // AJOUTER UNE RÉSERVATION
    // ===================================================
    document.getElementById('formReservation').addEventListener('submit', async (e) => {
      e.preventDefault();

      await fetch('/api/reservations', { // ✅ /api/
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id_association:   document.getElementById('id_association').value,
          id_mjc:           document.getElementById('id_mjc').value,
          date_reservation: document.getElementById('date_reservation').value
        })
      });

      e.target.reset();
      charger();
    });

    // ===================================================
    // SUPPRIMER UNE RÉSERVATION
    // ===================================================
    async function supprimer(id) {
      if (!confirm('Supprimer cette réservation ?')) return;
      await fetch(`/api/reservations/${id}`, { method: 'DELETE' }); // ✅ /api/
      charger();
    }

    chargerSelects();
    charger();
  </script>
</body>
</html>